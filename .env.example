# Copier ce fichier en .env puis adapter les valeurs (le fichier .env n'est jamais versionné)
APP_URL=http://localhost:8000
APP_DEBUG=false

# Base relationnelle (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vg_app
DB_PASSWORD=ChangezMoi#2026
# Chemin du certificat CA si l'hébergeur impose TLS (ex. Aiven) : DB_SSL_CA=/app/ca.pem
DB_SSL_CA=
# ... ou directement le contenu du certificat (secret Fly.io) : DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n..."
DB_SSL_CA_PEM=

# Base NoSQL (MongoDB) — statistiques de l'administrateur
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vite_gourmand

# E-mails : "log" (fichier storage/logs/mails.log) ou "smtp"
MAIL_DRIVER=log
MAIL_FROM=no-reply@vite-gourmand.fr
MAIL_CONTACT=contact@vite-gourmand.fr
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Calcul des distances via api-adresse.data.gouv.fr + OSRM (on/off)
GEO_API=on
